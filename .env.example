# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://ahopoznyztqxzgxtfikr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # Project Settings -> API Keys -> Publishable key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...                   # Project Settings -> API Keys -> Secret key. Server only, never expose

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=business@ellimaa.com
COURSE_ACCESS_UNTIL=2027-04-30     # last day of full access (also shown in the terms)

# --- Morning (app.greeninvoice.co.il -> המשתמש שלי -> כלי מפתחים -> API Keys) ---
MORNING_ENV=production            # or: sandbox
MORNING_API_KEY_ID=
MORNING_API_KEY_SECRET=
MORNING_PLUGIN_ID=                # optional; see README
MORNING_DOC_TYPE=400               # עוסק פטור: 400 = קבלה (320 = חשבונית מס/קבלה for עוסק מורשה)
MORNING_VAT_TYPE=0                # עוסק פטור: 0 (business default). 1 = VAT included, 2 = exempt
MORNING_WEBHOOK_SECRET=           # any long random string; protects the notify URL
COURSE_PRICE_ILS=69

# --- platform ---
OWNER_EMAILS=lior.livovsky213@gmail.com        # free access to every course + /admin
RESEND_API_KEY=                                # update e-mails to course users (Resend > API Keys)
MAIL_FROM=LCOURSE <noreply@ellimaa.com>        # an address on the domain verified in Resend
NEXT_PUBLIC_GOOGLE_LOGIN=on                    # set to off to hide the Google button
